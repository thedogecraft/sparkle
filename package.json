{
  "name": "sparkle",
  "version": "2.25.0",
  "description": "Sparkle",
  "main": "./out/main/index.js",
  "author": "Parcoil",
  "homepage": "https://getsparkle.net",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -w",
    "build": "node build.js",
    "build:registry": "pnpm run build -- --registry",
    "build:electron": "pnpm run build:vite && electron-builder",
    "build:vite": "electron-vite build",
    "postinstall": "electron-builder install-app-deps && npx install-electron",
    "build:unpack": "pnpm run build:vite && electron-builder --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run  --reporter=verbose",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test:all": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "discord-rpc-new": "^1.4.3",
    "electron-log": "^5.4.4",
    "electron-store": "8.1.0",
    "electron-updater": "^6.8.11",
    "systeminformation": "^5.33.18"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@lucide/lab": "^0.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "electron": "^45.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lucide-react": "^1.63.0",
    "postcss": "^8.5.32",
    "posthog-js": "^1.441.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.2.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "repository": "https://github.com/Parcoil/Sparkle",
  "build": {
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Parcoil",
        "repo": "Sparkle",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "*.exe",
          "*.ico",
          "*.nip",
          "*.pow"
        ]
      }
    ],
    "appId": "com.parcoil.sparkle",
    "productName": "sparkle",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "!**/.vscode/*",
      "!src/*",
      "!dist-old",
      "!dist-2",
      "!electron-builde.yml",
      "!images/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml,yarn.lock}",
      "!docs/**",
      "!eslint.config.mjs",
      "!get.ps1",
      "!packages/*",
      "!license",
      "!trusted-dependencies-scripts.json",
      "!postcss.config.js",
      "!tsconfig.json",
      "!tsconfig.node.json",
      "!tsconfig.web.json",
      "!build.js",
      "!jsconfig.json",
      "!LICENSE",
      "!scripts/**",
      "!bucket/**",
      "!pnpm-workspace.yaml",
      "!vitest.config.ts",
      "!resources/**",
      "!chocolatey/**"
    ],
    "win": {
      "executableName": "sparkle",
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "resources/sparkle2.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "${name}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always",
      "oneClick": false,
      "installerSidebar": "build/sparkleinstallerleftsidebar.bmp",
      "uninstallerSidebar": "build/sparkleinstallerleftsidebar.bmp",
      "installerHeader": "build/sparkleinstallerheader.bmp"
    },
    "npmRebuild": false
  },
  "packageManager": "pnpm@10.29.3"
}
